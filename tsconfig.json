{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Decorators"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "jsx": "react-jsx",

    // Decorators: @microsoft/rayfin-core 1.33.x ships standard TC39
    // decorator typings (ClassDecoratorContext). Do NOT set
    // experimentalDecorators - it breaks compilation against this version.
    // (Earlier preview docs said the opposite; the package is the truth.)

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./rayfin" }]
}
