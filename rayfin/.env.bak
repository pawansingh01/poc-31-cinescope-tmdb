# rayfin/.env.example - CineScope: Film and TV Analytics (POC 31)
# Copy to rayfin/.env and fill in values. NEVER commit rayfin/.env.

# Fabric brokered auth (Entra SSO).
# MUST be true before running `npx rayfin up` for the first time.
# If left false, the deployed app's auth is broken with no helpful error.
FABRIC_AUTH_ENABLED=true

# Values below are written by the Rayfin CLI after `npx rayfin up`.
# Listed here for documentation only - do not set manually.
# VITE_RAYFIN_HOSTING_URL=
# VITE_RAYFIN_BASE_URL=
# VITE_RAYFIN_PUBLISHABLE_KEY=

# TMDb API key is NOT needed here. It is used only by the Fabric ingestion
# notebooks (stored in the notebook environment, never in frontend code).
